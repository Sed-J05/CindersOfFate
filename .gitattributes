# Shatranj — line endings and binary rules for a Unity project
* text=auto

# Code / text: normalise to LF in the repo
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.asmdef text eol=lf
*.inputactions text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Unity YAML
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.physicsMaterial2D text eol=lf
*.renderTexture text eol=lf
*.scenetemplate text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.fbx binary
*.dll binary
*.exe binary
