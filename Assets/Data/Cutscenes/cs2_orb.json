{
  // Cutscene 2 — THE ORB / PHASE CHANGE (Docs/08 §3, ≈ 70 s). Triggered by touching the orb at the end of Phase 1.
  "id": "cs2_orb",
  "theme": "Phase1_Beige",
  "skipHoldTime": 1.0,
  "beats": [
    { "type": "music", "id": "music_memory" },
    // 1. The orb pulses; white flash
    { "type": "fade", "to": "clear", "time": 0.6 },
    { "type": "spawn", "id": "orb",  "character": "Orb",         "anim": "Idle", "pos": [2.0, -3.2], "scale": 1.6, "layer": "Props" },
    { "type": "spawn", "id": "hero", "character": "Protagonist", "anim": "Idle", "pos": [-1.2, -4.6] },
    { "type": "wait", "time": 0.8 },
    { "type": "anim", "id": "orb", "anim": "Touch" },
    { "type": "flash", "colour": "white", "time": 0.3 },
    { "type": "shake", "amp": 0.2, "time": 0.4 },
    { "type": "wait", "time": 0.6 },

    // 2–3. Memories: fast cuts (1.8 s each, shake / flash) while the inner voice speaks
    { "type": "parallel", "beats": [
      { "type": "theme", "theme": "Cutscene", "time": 0.8 },
      { "type": "remove", "id": "orb",  "fade": 0.5 },
      { "type": "remove", "id": "hero", "fade": 0.5 }
    ] },
    { "type": "parallel", "beats": [
      { "type": "sequence", "beats": [
        { "type": "image", "id": "memory", "sprite": "CS2_Memory_01", "layer": "Foreground", "fade": 0.15, "kenburns": { "from": [1.0, 0, 0], "to": [1.08, 0, 0], "time": 1.8 } },
        { "type": "wait", "time": 1.65 },
        { "type": "flash", "colour": "white", "time": 0.15 },
        { "type": "image", "id": "memory", "sprite": "CS2_Memory_02", "layer": "Foreground", "fade": 0.1, "kenburns": { "from": [1.08, 0, 0], "to": [1.0, 0, 0], "time": 1.8 } },
        { "type": "shake", "amp": 0.12, "time": 0.3 },
        { "type": "wait", "time": 1.7 },
        { "type": "image", "id": "memory", "sprite": "CS2_Memory_03", "layer": "Foreground", "fade": 0.1, "kenburns": { "from": [1.0, -0.5, 0], "to": [1.06, 0.5, 0], "time": 1.8 } },
        { "type": "wait", "time": 1.65 },
        { "type": "flash", "colour": "white", "time": 0.15 },
        { "type": "image", "id": "memory", "sprite": "CS2_Memory_04", "layer": "Foreground", "fade": 0.1, "kenburns": { "from": [1.06, 0, 0.3], "to": [1.0, 0, -0.3], "time": 1.8 } },
        { "type": "shake", "amp": 0.15, "time": 0.3 },
        { "type": "wait", "time": 1.7 },
        { "type": "image", "id": "memory", "sprite": "CS2_Memory_05", "layer": "Foreground", "fade": 0.1, "kenburns": { "from": [1.0, 0, 0], "to": [1.1, 0, 0], "time": 1.8 } },
        { "type": "wait", "time": 1.65 },
        { "type": "flash", "colour": "white", "time": 0.15 },
        { "type": "image", "id": "memory", "sprite": "CS2_Memory_06", "layer": "Foreground", "fade": 0.1, "kenburns": { "from": [1.1, 0.4, 0], "to": [1.0, -0.4, 0], "time": 1.8 } },
        { "type": "wait", "time": 1.8 }
      ] },
      { "type": "sequence", "beats": [
        { "type": "wait", "time": 0.6 },
        { "type": "text", "style": "inner", "lines": [
          "I remember… a throne of light.",
          "I remember… something I cast away.",
          "Its home is the castle beyond the cave."
        ] }
      ] }
    ] },

    // 4. The castle on the cliff (Ken Burns up)
    { "type": "image", "id": "castle", "sprite": "CS2_Castle_Silhouette", "layer": "Foreground", "fade": 0.6, "kenburns": { "from": [1.12, 0, -0.8], "to": [1.12, 0, 0.8], "time": 4.5 } },
    { "type": "remove", "id": "memory" },
    { "type": "wait", "time": 3.6 },

    // 5. Two crimson eyes open in the dark
    { "type": "image", "id": "eyes", "sprite": "CS2_Zulmat_Eyes", "layer": "Foreground", "fade": 0.25 },
    { "type": "parallel", "beats": [
      { "type": "shake", "amp": 0.6, "time": 0.8 },
      { "type": "flame", "intensity": 1.6, "time": 0.4 },
      { "type": "text", "speaker": "???", "style": "boss", "lines": ["…You remember. Then I am awake."] }
    ] },
    { "type": "parallel", "beats": [
      { "type": "remove", "id": "castle", "fade": 0.6 },
      { "type": "remove", "id": "eyes",   "fade": 0.6 },
      { "type": "theme", "theme": "Phase1_Beige", "time": 0.6 }
    ] },

    // 6. Back on stage: the inversion wipe from the flame — blue flame, inverted theatre, flame arc restarts at t = 0
    { "type": "spawn", "id": "hero", "character": "Protagonist_P2", "recolor": false, "anim": "Idle", "pos": [0, -4.6] },
    { "type": "invertWipe", "time": 1.5, "theme": "Phase2_Inverted", "flameT": 0 },

    // 7.
    { "type": "text", "style": "narration", "lines": ["The light behind the screen changed. So did everything on it."] },

    // 8. Powers return; Phase 2 (7 hearts, dash + fireball)
    { "type": "flash", "colour": "#CFEAFF", "time": 0.4 },
    { "type": "card", "text": "TIME SLIP  (L)", "sub": "Slip through time — dash through danger.", "time": 1.6, "colour": "#E8D9B5" },
    { "type": "card", "text": "FLAMECALL  (K)", "sub": "Tap K to hurl a blue flame.", "time": 1.6, "colour": "#E8D9B5" },
    { "type": "setFlag", "flag": "phase", "value": 2 },
    { "type": "setFlag", "flag": "titleCard", "value": "PHASE II|THE INVERTED THEATRE" },

    // 9. → Phase 2 (spawn at 'P' in P2_C0)
    { "type": "fade", "to": "black", "time": 1.0 },
    { "type": "loadScene", "scene": "Phase2_Castle", "fade": 0.8 }
  ]
}
