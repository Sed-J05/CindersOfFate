{
  // Cutscene 1 — INTRO (Docs/08 §2, ≈ 40 s). Coordinates: world units from the screen centre (screen = 19.6 × 11 u).
  // Edit freely: in the Editor this file is re-read every time the cutscene plays.
  "id": "cs1_intro",
  "theme": "Phase1_Beige",
  "skipHoldTime": 1.0,
  "instantSkipFromCycle": 2,
  "beats": [
    { "type": "music", "id": "music_intro" },
    // 1. Black → parchment, title card 2.5 s
    { "type": "fade", "to": "black", "time": 0 },
    { "type": "image", "id": "logo", "sprite": "Title_Logo", "fit": "none", "layer": "Foreground", "fade": 0,
      "kenburns": { "from": [1.0, 0, 0.6], "to": [1.06, 0, 0.6], "time": 4.5 } },
    { "type": "fade", "to": "clear", "time": 1.5 },
    { "type": "wait", "time": 2.5 },
    { "type": "remove", "id": "logo", "fade": 0.8 },
    { "type": "text", "voices": ["vo_cs1_01"], "style": "narration", "lines": ["…again."], "minCycle": 2 },

    // 2. Village (3 parallax layers), slow pan right, flame flickers behind
    { "type": "parallel", "beats": [
      { "type": "image", "id": "villageFar",  "sprite": "CS1_Village_Far",  "fade": 1.2, "kenburns": { "from": [1.12,  1.0, 0], "to": [1.12, -1.0, 0], "time": 16 } },
      { "type": "image", "id": "villageMid",  "sprite": "CS1_Village_Mid",  "fade": 1.2, "kenburns": { "from": [1.16,  1.6, 0], "to": [1.16, -1.6, 0], "time": 16 } },
      { "type": "image", "id": "villageNear", "sprite": "CS1_Village_Near", "fade": 1.2, "kenburns": { "from": [1.20,  2.4, 0], "to": [1.20, -2.4, 0], "time": 16 } },
      { "type": "flame", "colour": "orange", "intensity": 1.3, "time": 0.6 }
    ] },

    // 3.
    { "type": "text", "voices": ["vo_cs1_02"], "style": "narration", "lines": ["Our village slept beneath the mountain's shadow."] },

    // 4–5. Crawler / Lunger puppets cross the village; small shake; flame flares
    { "type": "spawn", "id": "crawler", "character": "Crawler", "anim": "Walk", "pos": [-11.5, -4.4], "scale": 1.3, "layer": "Enemies" },
    { "type": "spawn", "id": "lunger",  "character": "Lunger",  "anim": "Walk", "pos": [-14.0, -4.4], "scale": 1.3, "layer": "Enemies" },
    { "type": "parallel", "beats": [
      { "type": "move", "id": "crawler", "to": [12.5, -4.4], "time": 6, "ease": "Linear" },
      { "type": "move", "id": "lunger",  "to": [11.0, -4.4], "time": 6, "ease": "Linear" },
      { "type": "shake", "amp": 0.15, "time": 0.6 },
      { "type": "flame", "intensity": 1.5, "time": 0.3 },
      { "type": "sequence", "beats": [
        { "type": "wait", "time": 1.2 },
        { "type": "text", "voices": ["vo_cs1_03"], "style": "narration", "lines": ["Then the shadows began to move."] }
      ] }
    ] },
    { "type": "remove", "id": "crawler" },
    { "type": "remove", "id": "lunger" },

    // 6. The protagonist looks toward the mountain
    { "type": "spawn", "id": "hero", "character": "Protagonist", "anim": "Idle", "pos": [-4.0, -4.6], "scale": 1.0 },
    { "type": "wait", "time": 0.6 },
    { "type": "text", "style": "inner", "lines": ["The source of this lies in the cave."] },

    // 7. Runs right; the background slides to the cave mouth
    { "type": "anim", "id": "hero", "anim": "Run" },
    { "type": "parallel", "beats": [
      { "type": "move", "id": "hero", "to": [11.5, -4.6], "time": 3, "ease": "Linear" },
      { "type": "image", "id": "caveMouth", "sprite": "CS1_CaveMouth", "fade": 2.2, "kenburns": { "from": [1.15, 3.0, 0], "to": [1.0, 0, 0], "time": 3 } }
    ] },
    { "type": "remove", "id": "villageFar" },
    { "type": "remove", "id": "villageMid" },
    { "type": "remove", "id": "villageNear" },

    // 8. Fade to black → Phase 1 (new game spawns at 'P' in P1_A0)
    { "type": "fade", "to": "black", "time": 1.2 },
    { "type": "loadScene", "scene": "Phase1_Cave", "fade": 0.8 }
  ]
}
